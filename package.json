{
  "name": "heima-accounting",
  "productName": "黑马记账",
  "version": "1.0.0",
  "description": "记账 —— Windows 个人收支记账桌面软件",
  "main": "out/main/index.js",
  "author": "Lili Zheng",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "icon": "electron scripts/make-icon.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "echarts": "^6.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11",
    "vue": "^3.5.42",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.heima.accounting",
    "productName": "黑马记账",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "黑马记账",
      "installerLanguages": [
        "zh_CN"
      ]
    }
  }
}
